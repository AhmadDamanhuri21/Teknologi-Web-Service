generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Destinasi {
  id          Int    @id @default(autoincrement())
  nama        String
  kategori    String
  lokasi      String
  deskripsi   String
  hargaTiket  Int
  ratingRata  Float
}

model User {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  password  String
  role      String   @default("wisatawan")
  createdAt DateTime @default(now())
}